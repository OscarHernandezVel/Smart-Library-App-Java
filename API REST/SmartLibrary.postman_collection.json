{
  "info": {
    "_postman_id": "e6f4cb41-7f15-4e73-a4c8-98db974a577c",
    "name": "SmartLibrary Escenarios",
    "description": "Reiniciar la aplicación (H2 en memoria recarga data.sql) y ejecutar la colección en orden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Préstamo de libro disponible -> 201",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
              "pm.test(\"Header Location presente\", () => pm.response.to.have.header(\"Location\"));",
              "const j = pm.response.json();",
              "pm.test(\"Préstamo registrado (estudiante 1, libro 1, fecha)\", () => {",
              "  pm.expect(j.id).to.be.a(\"number\");",
              "  pm.expect(j.estudianteId).to.eql(1);",
              "  pm.expect(j.libroId).to.eql(1);",
              "  pm.expect(j.fechaPrestamo).to.be.a(\"string\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/prestamos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "prestamos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"estudianteId\": 1,\n  \"libroId\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "2. Libro ya prestado -> 409",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"409 Conflict\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
