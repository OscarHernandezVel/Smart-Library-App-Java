    {
      "name": "5. Consulta de préstamos del estudiante 1 -> 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test(\"Devuelve registros\", () => {",
              "  pm.expect(j).to.be.an(\"array\").that.is.not.empty;",
              "  pm.expect(j[0].estudianteId).to.eql(1);",
              "  pm.expect(j[0].libroId).to.eql(1);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/prestamos?estudianteId=1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
